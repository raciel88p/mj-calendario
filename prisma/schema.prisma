datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("Recepción")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id            String          @id @default(uuid())
  fullName      String
  cedula        String          @unique
  email         String          @unique
  phone         String
  whatsapp      String?
  residence     String?
  dob           DateTime?
  gender        String?
  allergies     String?
  notes         String?
  consent       Boolean         @default(false)
  signatureUrl  String?
  photos        String[]        @default([])
  hasMembership Boolean         @default(false)
  crmStage      String          @default("Nuevo Lead")
  appointments  Appointment[]
  payments      Payment[]
  packages      PatientPackage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Treatment {
  id           String        @id @default(uuid())
  name         String
  category     String
  durationMins Int           @default(60)
  price        Float
  color        String        @default("#3B82F6")
  description  String?
  active       Boolean       @default(true)
  appointments Appointment[]
  packages     Package[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Professional {
  id           String        @id @default(uuid())
  name         String
  specialty    String?
  active       Boolean       @default(true)
  appointments Appointment[]
}

model Cabin {
  id           String        @id @default(uuid())
  name         String
  appointments Appointment[]
}

model Appointment {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentId    String
  treatment      Treatment    @relation(fields: [treatmentId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  cabinId        String?
  cabin          Cabin?       @relation(fields: [cabinId], references: [id])
  dateTime       DateTime
  durationMins   Int          @default(60)
  price          Float
  deposit        Float        @default(0)
  status         String       @default("Pendiente")
  notes          String?
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  amount        Float
  paymentMethod String
  voucher       String?
  createdAt     DateTime     @default(now())
}

model AssistantGoal {
  id            String   @id @default(uuid())
  name          String
  role          String   @default("Asistente Dental / Estética")
  monthlyTarget Float    @default(1500000)
  currentSales  Float    @default(0)
  efficiency    Int      @default(90)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Package {
  id             String           @id @default(uuid())
  name           String
  treatmentId    String
  treatment      Treatment        @relation(fields: [treatmentId], references: [id])
  totalSessions  Int
  price          Float
  active         Boolean          @default(true)
  patientPackages PatientPackage[]
  createdAt      DateTime         @default(now())
}

model PatientPackage {
  id                String         @id @default(uuid())
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id])
  packageId         String
  package           Package        @relation(fields: [packageId], references: [id])
  totalSessions     Int
  remainingSessions Int
  price             Float
  status            String         @default("Activo") // Activo, Agotado, Vencido
  usages            PackageUsage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PackageUsage {
  id               String         @id @default(uuid())
  patientPackageId String
  patientPackage   PatientPackage @relation(fields: [patientPackageId], references: [id])
  usedAt           DateTime       @default(now())
  notes            String?
}

model CashRegister {
  id             String    @id @default(uuid())
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  initialBalance Float     @default(50000) // ₡50,000 colones
  efectivoSales  Float     @default(0)
  sinpeSales     Float     @default(0)
  tarjetaSales   Float     @default(0)
  status         String    @default("Abierto") // Abierto, Cerrado
  notes          String?
}

model Setting {
  id          String @id @default("default")
  companyName String @default("MJ Estética")
  logoUrl     String?
  phone       String @default("+506 8888-8888")
  address     String @default("San José, Costa Rica")
  reminderTpl String @default("Hola {nombre}. Le recordamos su cita de {tratamiento} el día {fecha} a las {hora}. MJ Estética.")
}
